{
  "rewrites": [
    { "source": "/jobs/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/jobs/_serverFn/:path*", "destination": "/_serverFn/:path*" },
    { "source": "/jobs/__grok/:path*", "destination": "/__grok/:path*" },
    { "source": "/jobs", "destination": "/" },
    { "source": "/jobs/", "destination": "/" },
    { "source": "/jobs/:path*", "destination": "/:path*" }
  ]
}
